---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RouteNav from '../components/RouteNav.astro';
import Timeline from '../components/Timeline.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Chips from '../components/Chips.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import { ADULTOS_NAV, ROUTES, citaHref, img, serviceSchema, withBase } from '../lib/site';

const path = ROUTES.adultos;
const title = 'Fisioterapia y osteopatía para adultos en Burriana | Centro Spai';
const description =
  'Tratamientos de fisioterapia y osteopatía para adultos, embarazo y posparto en Burriana. Solicita tu cita.';
const breadcrumbs = [
  { label: 'Inicio', href: ROUTES.home },
  { label: 'Adultos y bienestar', href: path },
];

const groups = [
  {
    id: 'dolor',
    kicker: 'Dolor, tensión y lesiones',
    title: 'Aliviar molestias y recuperar confianza',
    text: 'Para dolor de espalda, cuello o articulaciones, tensión muscular o la recuperación tras una lesión.',
    chips: ['Terapia manual', 'Osteopatía', 'Punción seca', 'Indiba'],
    image: {
      src: 'adultos-bienestar/fisioterapia-adultos.png',
      alt: 'Ilustración de una persona realizando estiramientos sobre una pelota de ejercicio',
      isPhoto: false,
    },
  },
  {
    id: 'movimiento',
    kicker: 'Movimiento y ejercicio',
    title: 'Moverte mejor en tu día a día',
    text: 'Ejercicio guiado para ganar movilidad, trabajar la postura y sentirte más fuerte, a tu ritmo.',
    chips: ['Pilates', 'Movilidad', 'Postura'],
    image: {
      src: 'adultos-bienestar/bienestar-y-relax.jpg',
      alt: 'Fisioterapeuta realizando una valoración postural y tratamiento manual a una paciente',
      isPhoto: true,
    },
  },
  {
    id: 'bienestar',
    kicker: 'Bienestar y relax',
    title: 'Un momento para bajar el ritmo',
    text: 'Terapias orientadas al descanso y al bienestar general. Te explicamos el alcance de cada una en consulta.',
    chips: ['Terapias de relax', 'Drenaje', 'Medicina tradicional china', 'Fisioestética'],
    image: {
      src: 'adultos-bienestar/terapias-de-relax.png',
      alt: 'Ilustración de una persona en postura de relajación y meditación',
      isPhoto: false,
    },
  },
];

/**
 * Técnicas y tratamientos publicados por la web original. Es un inventario
 * histórico, no un compromiso de tratamiento ni una promesa de resultado.
 */
const inventario = [
  {
    label: 'Fisioterapia y osteopatía',
    image: {
      src: 'adultos-bienestar/fisioterapia-adultos.png',
      alt: 'Ilustración de una persona ejercitándose sobre una pelota de fitball',
    },
    items: [
      'Fisioterapia y terapias manuales',
      'Osteopatía estructural, craneal y visceral',
      'Terapia miofascial',
      'Punción seca',
      'Kinesiotaping',
      'Masaje',
      'Drenaje linfático manual',
      'Reeducación postural',
      'Electroterapia',
      'Recuperación de lesiones deportivas',
      'Pilates terapéutico',
      'Escoliosis',
      'Escuela y grupos de espalda',
    ],
  },
  {
    label: 'Embarazo y posparto',
    image: {
      src: 'adultos-bienestar/bienestar-y-relax.jpg',
      alt: 'Fisioterapeuta acompañando a una paciente durante una valoración',
    },
    items: [
      'Tratamientos para embarazadas',
      'Pilates para embarazadas',
      'Osteopatía visceral posparto',
      'Hipopresivos',
      'Reeducación del suelo pélvico',
      'Cicatriz tras cesárea',
    ],
    href: ROUTES.embarazo,
    linkLabel: 'Ver embarazo y posparto',
  },
  {
    label: 'Bienestar y medicina tradicional china',
    image: {
      src: 'adultos-bienestar/medicina-tradicional-china.png',
      alt: 'Ilustración de una sesión de ventosas sobre la espalda',
    },
    items: [
      'Terapias relax',
      'Medicina tradicional china',
      'Acupuntura',
      'Moxibustión',
      'Auriculoterapia',
      'Ventosas',
      'Fitoterapia china',
    ],
  },
  {
    label: 'Fisio-estética',
    image: {
      src: 'adultos-bienestar/fisioterapia-estetica.png',
      alt: 'Ilustración de una sesión de fisioterapia estética en camilla',
    },
    items: [
      'Fisio-estética',
      'Tratamientos reductores y reafirmantes',
      'Indiba',
      'Radiofrecuencia corporal y facial',
      'Vacumterapia',
      'Láser lipolítico',
      'Cavitación',
      'Presoterapia',
    ],
  },
] as const;

const faqs = [
  {
    q: '¿Puedo pedir cita para mí si mi hijo ya es paciente del centro?',
    a: 'Claro. La ruta de adultos es independiente: pides tu propia cita y tienes tu propio seguimiento. Si os viene bien, intentamos coordinar horarios.',
  },
  {
    q: '¿Cómo sé qué tratamiento necesito?',
    a: 'No hace falta que lo sepas al pedir cita. Qué enfoque encaja mejor es algo que valora el profesional que te atiende.',
  },
  {
    q: '¿Qué ropa llevo a la sesión?',
    a: 'Ropa cómoda que te permita moverte. Si vienes a una sesión de ejercicio, mejor ropa deportiva.',
  },
  {
    q: '¿Las terapias de bienestar sustituyen a un tratamiento médico?',
    a: 'No. Son terapias complementarias orientadas al bienestar. Si tienes una patología o estás en tratamiento, coméntanoslo para valorar qué es adecuado.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  tone="adultos"
  image="images/adultos-bienestar/bienestar-y-relax.jpg"
  imageAlt="Fisioterapeuta colocando las manos sobre el hombro y la espalda de una paciente"
  preloadImage="images/adultos-bienestar/bienestar-y-relax.jpg"
  breadcrumbs={breadcrumbs}
  jsonLd={[serviceSchema('Fisioterapia y osteopatía para adultos', description)]}
>
  <PageHero
    tone="adultos"
    eyebrow="Adultos y bienestar"
    lead="Tu propio espacio de cuidado. Fisioterapia, osteopatía y terapias de bienestar para aliviar molestias, moverte mejor y dedicarte un momento."
    breadcrumbs={breadcrumbs}
    image={{
      src: 'adultos-bienestar/bienestar-y-relax.jpg',
      alt: 'Fisioterapeuta colocando las manos sobre el hombro y la espalda de una paciente',
      width: 1920,
      height: 699,
      position: '30% 40%',
    }}
  >
    <Fragment slot="title">Fisioterapia y osteopatía <em>para adultos</em> en Burriana</Fragment>
    <Fragment slot="actions">
      <a class="btn btn--well btn--lg" href={citaHref('adultos')}>
        Pedir cita para adultos
        <Icon name="arrow-right" />
      </a>
      <a class="btn btn--secondary btn--lg adult-secondary" href="#tratamientos">Ver tratamientos</a>
    </Fragment>
  </PageHero>

  <RouteNav currentPath={path} tone="adultos" label="Adultos y bienestar" items={ADULTOS_NAV} />

  <!-- Tratamientos agrupados -->
  <section class="section" id="tratamientos" aria-labelledby="tratamientos-title">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <span class="eyebrow eyebrow--well">Tratamientos</span>
          <h2 id="tratamientos-title">Empieza por <em class="well">lo que buscas</em></h2>
        </div>
        <p class="lead">
          Hemos agrupado los tratamientos por objetivo. En la primera sesión te ayudamos a elegir, sin catálogos
          interminables.
        </p>
      </div>

      <div class="groups">
        {
          groups.map((g, i) => (
            <article class:list={['group', { 'group--reverse': i % 2 === 1 }]} id={g.id} data-reveal>
              <div class="group__media">
                {g.image.isPhoto ? (
                  <div class="group__photo-frame">
                    <Picture
                      src={g.image.src}
                      alt={g.image.alt}
                      width={434}
                      height={320}
                      loading="lazy"
                      decoding="async"
                      class="group__photo"
                    />
                  </div>
                ) : (
                  <Picture
                    src={g.image.src}
                    alt={g.image.alt}
                    width={345}
                    height={253}
                    loading="lazy"
                    decoding="async"
                    class="illus"
                  />
                )}
              </div>
              <div class="group__body">
                <span class="group__kicker">{g.kicker}</span>
                <h3>{g.title}</h3>
                <p>{g.text}</p>
                <Chips tone="adultos" label={`Tratamientos de ${g.kicker.toLowerCase()}`} items={g.chips} />
              </div>
            </article>
          ))
        }

        <a class="group-link" href={withBase(ROUTES.embarazo)} data-reveal>
          <span class="group-link__icon">
            <Icon name="leaf" size={28} />
          </span>
          <span class="group-link__body">
            <span class="group__kicker">Embarazo y posparto</span>
            <span class="group-link__title">Acompañamiento en una etapa de grandes cambios</span>
            <span class="group-link__text">Fisioterapia durante el embarazo y en la recuperación tras el parto.</span>
          </span>
          <span class="group-link__arrow">
            <Icon name="arrow-right" />
          </span>
        </a>
      </div>
      <p class="scope-note" data-reveal>
        <Icon name="info" size={18} />
        Las técnicas que aparecen aquí figuraban en la web anterior de Centro Spai. Se muestran como oferta
        heredada; su vigencia actual la confirmará el centro y no constituyen un compromiso de tratamiento.
      </p>
    </div>
  </section>

  <!-- Inventario heredado -->
  <section class="section surface-well" id="inventario" aria-labelledby="inventario-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow eyebrow--well">Catálogo heredado</span>
        <h2 id="inventario-title">Tratamientos y técnicas presentes <em class="well">en la web original</em></h2>
        <p class="lead">
          Este es el inventario que Centro Spai tenía publicado para adultos. Se recoge íntegro para no perder la
          herencia del centro: no describe resultados ni sustituye una valoración profesional.
        </p>
      </div>
      <div class="inventory">
        {
          inventario.map((group, i) => (
            <section class="inventory__group" data-reveal style={`--reveal-i:${i}`} aria-label={group.label}>
              <figure class="inventory__media">
                <Picture
                  src={group.image.src}
                  alt={group.image.alt}
                  width={345}
                  height={253}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="inventory__body">
                <h3>{group.label}</h3>
                <ul class="inventory__list">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                {group.href && (
                  <a class="link-arrow" href={withBase(group.href)}>
                    {group.linkLabel}
                    <Icon name="arrow-right" />
                  </a>
                )}
              </div>
            </section>
          ))
        }
      </div>
      <p class="inventory__note" data-reveal>
        <Icon name="info" size={20} />
        <span>
          Inventario heredado de la web anterior. La vigencia de cada técnica, el profesional responsable y su
          titulación los confirmará el centro antes de una web pública.
        </span>
      </p>
    </div>
  </section>

  <!-- Proceso -->
  <section class="section" aria-labelledby="proceso-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow eyebrow--well">Cómo imaginamos la atención</span>
        <h2 id="proceso-title">Un plan claro, <em class="well">desde el primer encuentro</em></h2>
        <p class="proposal-tag">Propuesta de experiencia, pendiente de validar con el centro</p>
      </div>
      <Timeline
        tone="adultos"
        steps={[
          {
            icon: 'chat',
            title: 'Nos cuentas',
            text: 'Qué te ocurre, desde cuándo y cómo afecta a tu día a día.',
          },
          {
            icon: 'clipboard',
            title: 'Valoración',
            text: 'Una valoración inicial para entender tu situación antes de proponer nada.',
          },
          {
            icon: 'path',
            title: 'Seguimiento',
            text: 'Explicaciones claras sobre qué se hace en cada sesión y por qué.',
          },
        ]}
      />
    </div>
  </section>

  <!-- Puente con infantil -->
  <section class="section section--tight" aria-labelledby="puente-title">
    <div class="container">
      <div class="bridge" data-reveal>
        <span class="bridge__icon"><Icon name="baby" size={28} /></span>
        <div>
          <h2 id="puente-title" class="bridge__title">¿Buscas atención para tu bebé o tu hijo?</h2>
          <p class="muted">La ruta infantil tiene su propio espacio, servicios y cita.</p>
        </div>
        <a class="btn btn--secondary" href={withBase(ROUTES.infantil)}>Ir a la ruta infantil</a>
      </div>
    </div>
  </section>

  <Faq items={faqs} tone="adultos" title="Preguntas sobre la atención adulta" />

  <CtaBand
    tone="adultos"
    eyebrow="Tu cita"
    title="Dedícate un momento"
    text="Cuéntanos qué necesitas y el centro te dirá qué cita encaja mejor."
  />
</BaseLayout>

<style>
  .well {
    color: var(--sage-800) !important;
  }

  .adult-secondary {
    --btn-fg: var(--sage-800);
    --btn-border: #9fbfa7;
  }

  .adult-secondary:hover {
    --btn-fg: var(--sage-800);
    --btn-border: var(--sage-800);
  }

  .groups {
    display: grid;
    gap: var(--space-5);
  }

  .group {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
    border-radius: var(--radius-panel);
    background: var(--white);
    border: 1px solid #dde8df;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .group {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: var(--space-7);
    }

    .group--reverse .group__media {
      order: 2;
    }
  }

  .group__media {
    display: grid;
    place-items: center;
  }

  .group__media :global(img) {
    box-shadow: 0 0 0 1px var(--sage-200), var(--shadow-soft);
  }

  .group__media img.illus {
    --illus-size: 13rem;
    padding: 0;
    object-fit: cover;
  }

  .group__photo-frame {
    width: 100%;
    max-width: 14.5rem;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--sage-200), var(--shadow-soft);
    background: var(--cloud-100);
  }

  .group__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 24% 28%;
    box-shadow: none !important;
  }

  .group__body {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .group__kicker {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--sage-800);
  }

  .group__body h3 {
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
  }

  .group__body p {
    color: var(--text-muted);
    max-width: 36rem;
  }

  .group-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-5);
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
    border-radius: var(--radius-panel);
    background: var(--sage-100);
    border: 1px solid var(--sage-200);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  .group-link:hover {
    color: inherit;
    border-color: var(--sage-800);
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }

  .group-link__icon,
  .group-link__arrow {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 16px;
    background: var(--white);
    color: var(--sage-800);
  }

  .group-link__arrow {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
  }

  .group-link__body {
    display: grid;
    gap: var(--space-1);
  }

  .group-link__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1.2;
    color: var(--spai-700);
  }

  .group-link__text {
    color: var(--text-muted);
  }

  @media (max-width: 35.99rem) {
    .group-link {
      grid-template-columns: 1fr;
    }

    .group-link__arrow {
      display: none;
    }
  }

  .scope-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2) var(--space-3);
    max-width: 52rem;
    margin-top: var(--space-5);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .inventory {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .inventory {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .inventory__group {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-radius: var(--radius-panel);
    background: var(--white);
    border: 1px solid #dde8df;
  }

  .inventory__media {
    margin: 0;
    display: grid;
    place-items: center;
  }

  .inventory__media :global(img) {
    width: 100%;
    max-width: 11rem;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    padding: 6%;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 0 0 1px var(--sage-200), var(--shadow-soft);
    filter: brightness(1.055) saturate(1.06);
  }

  .inventory__body h3 {
    font-size: 1.375rem;
    color: var(--sage-800);
    margin-bottom: var(--space-3);
  }

  .inventory__list {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .inventory__list li::marker {
    color: #9fbfa7;
  }

  .inventory__body .link-arrow {
    margin-top: var(--space-3);
    color: var(--sage-800);
  }

  .inventory__note {
    display: flex;
    gap: var(--space-3);
    max-width: 52rem;
    margin-top: var(--space-6);
    font-size: var(--fs-small);
    color: var(--ink-900);
  }

  .inventory__note :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--sage-800);
  }

  .bridge {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-panel);
    background: var(--lilac-100);
  }

  .bridge__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 16px;
    background: var(--white);
    color: var(--spai-700);
  }

  .bridge__title {
    font-size: 1.375rem;
  }

  @media (max-width: 47.99rem) {
    .bridge {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
</style>
