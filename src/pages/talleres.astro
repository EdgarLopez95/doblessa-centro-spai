---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Chips from '../components/Chips.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import { ROUTES, citaHref, withBase } from '../lib/site';

const path = ROUTES.talleres;
const title = 'Talleres y recursos para familias | Centro Spai';
const description =
  'Talleres y recursos de Centro Spai para familias: Taller Moquitos, en formato online, y las aplicaciones sobre cólicos del lactante.';
const breadcrumbs = [
  { label: 'Inicio', href: ROUTES.home },
  { label: 'Talleres y recursos', href: path },
];
// Talleres del catálogo publicado por la web del centro.
const talleresHistoricos = [
  {
    icon: 'sprout',
    title: 'Baby-Nesst',
    text: 'Estimulación del gateo y del desarrollo psicomotor, de 4 a 12 meses.',
  },
  {
    icon: 'baby',
    title: 'Estimulación sensorial',
    text: 'Propuestas de estimulación para bebés de 0 a 6 meses.',
  },
  {
    icon: 'chat',
    title: 'Lenguaje y signos del bebé',
    text: 'Taller sobre comunicación temprana con el bebé mediante signos.',
  },
  {
    icon: 'hands',
    title: 'Masaje infantil',
    text: 'Taller para aprender el masaje infantil y aplicarlo en casa.',
  },
] as const;

// noindex mientras el mockup viva en GitHub Pages (ver BUG-08)
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  tone="infantil"
  image="images/talleres-app/taller-moquitos.jpg"
  imageAlt="Niña sonándose la nariz con un pañuelo"
  breadcrumbs={breadcrumbs}
  noindex
>
  <PageHero
    tone="infantil"
    eyebrow="Talleres y recursos"
    lead="Aprender juntos también es cuidar. Espacios prácticos y recursos pensados para que las familias resuelvan dudas del día a día con más tranquilidad."
    breadcrumbs={breadcrumbs}
  >
    <Fragment slot="title">Talleres y recursos <em>para familias</em></Fragment>
    <Fragment slot="actions">
      <a class="btn btn--lg" href="#taller-moquitos">
        Taller Moquitos
        <Icon name="arrow-right" />
      </a>
      <a class="btn btn--secondary btn--lg" href="#apps">Apps sobre cólicos</a>
    </Fragment>
  </PageHero>

  <!-- Taller Moquitos -->
  <section class="section section--tight" id="taller-moquitos" aria-labelledby="moquitos-title">
    <div class="container">
      <div class="clinical-note" style="margin-bottom: var(--space-6);" data-reveal>
        <Icon name="info" size={20} />
        <p>
          Los botones de inscripción y descarga de esta página son demostrativos: todavía no están conectados a un
          sistema de reservas ni a las tiendas de aplicaciones.
        </p>
      </div>
      <article class="workshop" data-reveal>
        <figure class="workshop__media">
          <Picture
            src="talleres-app/taller-moquitos.jpg"
            alt="Niña con coletas sonándose la nariz con un pañuelo"
            width={1920}
            height={699}
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="workshop__body">
          <div class="workshop__meta">
            <span class="tag">Taller para familias</span>
            <span class="tag tag--online">
              <Icon name="users" size={16} />
              Online
            </span>
          </div>
          <h2 id="moquitos-title">Taller <em>Moquitos</em></h2>
          <p class="lead">
            El taller de Centro Spai dedicado a los mocos y la congestión en la infancia.
          </p>
          <div class="workshop__cols">
            <div>
              <h3>Temas del taller</h3>
              <ul class="check-list">
                <li>La higiene nasal en la infancia.</li>
                <li>Los días de mocos y congestión.</li>
                <li>Cuándo conviene consultar con el pediatra.</li>
              </ul>
            </div>
            <div>
              <h3>Para quién</h3>
              <p class="muted">Madres, padres y cuidadores de bebés y niños pequeños.</p>
            </div>
          </div>
          <div class="workshop__online">
            <figure class="workshop__online-media">
              <Picture
                src="talleres-app/taller-moquitos-online.jpg"
                alt="Cartel del Taller Moquitos en formato online de Centro Spai"
                width={851}
                height={955}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="workshop__online-body">
              <h3>Taller Moquitos · Online</h3>
              <p class="muted">La web de Centro Spai presenta el Taller Moquitos en formato online.</p>
            </div>
          </div>
          <div class="workshop__actions">
            <a class="btn btn--lg" href={`${citaHref('infantil')}&motivo=taller`}>
              Apúntate al taller
              <Icon name="arrow-right" />
            </a>
            <p class="workshop__hint">
              Botón demostrativo: abre el formulario de contacto, que no envía datos.
            </p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Apps -->
  <section class="section surface-kids" id="apps" aria-labelledby="apps-title">
    <div class="container apps">
      <div class="apps__body" data-reveal>
        <span class="eyebrow">Recursos digitales</span>
        <h2 id="apps-title">Apps sobre <em>cólicos del lactante</em></h2>
        <p>
          La web original de Centro Spai promocionaba dos aplicaciones vinculadas a cólicos del lactante, con la
          llamada «Descarga nuestras apps».
        </p>
        <ul class="app-list">
          <li class="app">
            <Picture
              src="talleres-app/app-centro-spai-pantalla-01.jpg"
              alt="Icono de la aplicación No más Cólicos de Centro Spai"
              width={180}
              height={180}
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3>No más Cólicos</h3>
              <p>Una de las dos aplicaciones que aparecen en la web del centro.</p>
              <button type="button" class="btn btn--secondary app__cta" data-app-cta>
                <Icon name="arrow-right" size={18} />
                Descargar app
              </button>
            </div>
          </li>
          <li class="app">
            <Picture
              src="talleres-app/app-centro-spai-pantalla-02.jpg"
              alt="Icono de la aplicación Anticólicos de Centro Spai"
              width={180}
              height={179}
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3>Anticólicos</h3>
              <p>La segunda aplicación vinculada a cólicos del lactante.</p>
              <button type="button" class="btn btn--secondary app__cta" data-app-cta>
                <Icon name="arrow-right" size={18} />
                Descargar app
              </button>
            </div>
          </li>
        </ul>
        <div class="apps__stores">
          <Picture
            src="talleres-app/disponible-en-tiendas-app.png"
            alt="Distintivo de disponibilidad en tiendas de aplicaciones"
            width={200}
            height={44}
            loading="lazy"
            decoding="async"
          />
          <p class="apps__note" role="status" data-app-note>
            <Icon name="info" size={20} />
            <span data-app-note-text>
              Botones demostrativos: no enlazan a ninguna tienda de aplicaciones.
            </span>
          </p>
        </div>
      </div>
      <figure class="apps__media" data-reveal>
        <Picture
          src="talleres-app/app-centro-spai-presentacion.png"
          alt="Aplicación No más Cólicos de Centro Spai mostrada en un teléfono y una tableta"
          width={790}
          height={511}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- Banner heredado de las apps -->
  <section class="section section--tight" aria-label="Aplicaciones de Centro Spai">
    <div class="container">
      <figure class="apps__banner" data-reveal>
        <Picture
          src="talleres-app/app-centro-spai.jpg"
          alt=""
          width={1920}
          height={526}
          loading="lazy"
          decoding="async"
        />
        <figcaption class="apps__banner-caption">
          <span class="apps__banner-title">No más Cólicos · Anticólicos</span>
          <span class="apps__banner-text">Las dos aplicaciones que aparecen en la web de Centro Spai.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Talleres históricos -->
  <section class="section surface-warm" id="otros-talleres" aria-labelledby="otros-talleres-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Del catálogo de Centro Spai</span>
        <h2 id="otros-talleres-title">Otros talleres que formaban parte <em>de Centro Spai</em></h2>
        <p class="lead">Talleres que aparecen en la web del centro, junto al Taller Moquitos.</p>
      </div>
      <ul class="heritage-grid">
        {
          talleresHistoricos.map((t, i) => (
            <li class="heritage-card" data-reveal style={`--reveal-i:${i}`}>
              <span class="heritage-card__icon">
                <Icon name={t.icon} size={24} />
              </span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Otros temas -->
  <section class="section" aria-labelledby="temas-title">
    <div class="container container--narrow topics" data-reveal>
      <span class="eyebrow">Más adelante</span>
      <h2 id="temas-title">Otros temas <em>del catálogo</em></h2>
      <p class="muted">
        Otros temas del catálogo del centro, relacionados con la crianza y el cuidado diario de los más pequeños.
      </p>
      <Chips
        label="Temas para familias"
        items={[
          { label: 'Cólicos del lactante', href: ROUTES.colicos },
          { label: 'Masaje infantil', href: `${ROUTES.infantil}#orientacion` },
          { label: 'Crianza y hábitos', href: `${ROUTES.infantil}#orientacion` },
          { label: 'Desarrollo y movimiento', href: `${ROUTES.infantil}#desarrollo` },
        ]}
      />
    </div>
  </section>

  <CtaBand
    tone="infantil"
    title="¿Te interesa un taller?"
    text="Cuéntanos qué taller te interesa al pedir la cita."
  />
<script>
  // CTA visual de descarga: no enlaza a ninguna tienda sin verificar.
  const note = document.querySelector<HTMLElement>('[data-app-note-text]');
  const original = note?.textContent ?? '';
  let timer: number | undefined;
  document.querySelectorAll<HTMLButtonElement>('[data-app-cta]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!note) return;
      note.textContent = 'Botón demostrativo: en la web real llevaría a la ficha de la aplicación.';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        note.textContent = original;
      }, 6000);
    });
  });
</script>
</BaseLayout>

<style>
  .workshop {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-panel);
    background: var(--white);
    border: 1px solid var(--line);
  }

  .workshop__media {
    margin: 0;
    aspect-ratio: 16 / 7;
    background: #e9e1dc;
  }

  .workshop__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 20% 40%;
  }

  @media (max-width: 47.99rem) {
    .workshop__media {
      aspect-ratio: 4 / 3;
    }

    .workshop__media :global(img) {
      object-position: 24% 40%;
    }
  }

  .workshop__body {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
  }

  .workshop__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--lilac-100);
    color: var(--spai-700);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .workshop__cols {
    display: grid;
    gap: var(--space-6);
    margin-block: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 48rem) {
    .workshop__cols {
      grid-template-columns: 1.2fr 0.8fr;
      gap: var(--space-8);
    }
  }

  .workshop__cols h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-3);
  }

  .workshop__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .workshop__hint {
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: 24rem;
  }

  .tag--online {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--sky-100);
    color: var(--sky-800);
  }

  .workshop__online {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
    border-radius: 18px;
    background: var(--lilac-100);
  }

  @media (min-width: 40rem) {
    .workshop__online {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  .workshop__online-media {
    margin: 0;
  }

  .workshop__online-media :global(img) {
    width: 100%;
    max-width: 8rem;
    border-radius: 14px;
    object-fit: cover;
    aspect-ratio: 851 / 955;
    filter: brightness(1.22) saturate(1.05);
  }

  .workshop__online-body h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
  }

  .app__cta {
    margin-top: var(--space-3);
    min-height: 44px;
  }

  .apps__stores {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .apps__stores :global(img) {
    width: 10rem;
    height: auto;
  }

  .apps__banner {
    position: relative;
    display: grid;
    place-items: center;
    margin: 0;
    border-radius: var(--radius-panel);
    overflow: hidden;
    background: var(--sky-100);
  }

  .apps__banner :global(img) {
    width: 100%;
    height: clamp(9rem, 14vw, 12rem);
    object-fit: cover;
    object-position: 50% 45%;
  }

  .apps__banner-caption {
    position: absolute;
    display: grid;
    gap: 0.15rem;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .apps__banner-title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem);
    font-weight: 560;
    color: var(--spai-700);
  }

  .apps__banner-text {
    font-size: var(--fs-small);
    color: var(--ink-900);
  }

  .heritage-grid {
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .heritage-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .heritage-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .heritage-card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--white);
    border: 1px solid var(--line);
  }

  .heritage-card__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-1);
    border-radius: 14px;
    background: var(--blush-100);
    color: var(--spai-700);
  }

  .heritage-card h3 {
    font-size: 1.25rem;
  }

  .heritage-card p {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .apps {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .apps {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .apps__body {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .app-list {
    list-style: none;
    display: grid;
    gap: var(--space-3);
    width: 100%;
    margin-top: var(--space-2);
  }

  .app {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-3);
    border-radius: var(--radius-card);
    background: var(--white);
  }

  .app :global(img),
  .app__placeholder {
    width: 4rem;
    height: 4rem;
    border-radius: 14px;
  }

  .app__placeholder {
    display: grid;
    place-items: center;
    background: var(--blush-100);
    color: var(--spai-700);
  }

  .app h3 {
    font-size: 1.25rem;
  }

  .app p {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .apps__note {
    display: flex;
    gap: var(--space-3);
    font-size: var(--fs-small);
    color: var(--ink-600);
  }

  .apps__note :global(svg) {
    flex: none;
    margin-top: 1px;
    color: var(--sky-800);
  }

  .apps__media {
    margin: 0;
  }

  .apps__media :global(img) {
    width: 100%;
  }

  .topics {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
</style>
