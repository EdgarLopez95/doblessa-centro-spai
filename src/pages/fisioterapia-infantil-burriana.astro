---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RouteNav from '../components/RouteNav.astro';
import NeedCard from '../components/NeedCard.astro';
import ServiceEditorial from '../components/ServiceEditorial.astro';
import Timeline from '../components/Timeline.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Chips from '../components/Chips.astro';
import Icon from '../components/Icon.astro';
import { INFANTIL_NAV, ROUTES, citaHref, serviceSchema, withBase } from '../lib/site';

const path = ROUTES.infantil;
const title = 'Fisioterapia infantil en Burriana | Centro Spai';
const description =
  'Atención de fisioterapia infantil y osteopatía para bebés y niños en Burriana. Conoce el enfoque de Spai y solicita cita.';
const breadcrumbs = [
  { label: 'Inicio', href: ROUTES.home },
  { label: 'Fisioterapia infantil', href: path },
];

const stages = [
  {
    label: 'Primeros meses',
    items: [
      {
        icon: 'moon',
        title: 'Cólicos del lactante',
        text: 'Llanto intenso y difícil de calmar. Información y acompañamiento para la familia.',
        href: ROUTES.colicos,
        linkLabel: 'Ver cólicos',
      },
      {
        icon: 'hands',
        title: 'Osteopatía para bebés',
        text: 'Un abordaje manual y respetuoso, adaptado a la edad del bebé.',
        href: ROUTES.osteopatia,
        linkLabel: 'Ver osteopatía',
      },
    ],
  },
  {
    label: 'Crecimiento',
    items: [
      {
        icon: 'sprout',
        title: 'Desarrollo y movimiento',
        text: 'Postura, volteo, gateo y primeros pasos, acompañados etapa a etapa.',
        href: '#desarrollo',
        linkLabel: 'Leer más',
      },
      {
        icon: 'wind',
        title: 'Fisioterapia respiratoria',
        text: 'Ayuda en los procesos de mocos y congestión, con recursos para casa.',
        href: '#respiratorio',
        linkLabel: 'Leer más',
      },
    ],
  },
  {
    label: 'Familias',
    items: [
      {
        icon: 'heart',
        title: 'Masaje y orientación',
        text: 'Masaje infantil, hábitos y rutinas para el día a día.',
        href: '#orientacion',
        linkLabel: 'Leer más',
      },
      {
        icon: 'users',
        title: 'Talleres para familias',
        text: 'Espacios prácticos para aprender juntos, como el Taller Moquitos.',
        href: ROUTES.talleres,
        linkLabel: 'Ver talleres',
      },
    ],
  },
] as const;

/**
 * Ámbitos publicados por la web original de Centro Spai. Se presentan como
 * catálogo histórico agrupado, no como oferta clínica vigente ni como
 * promesa de tratamiento.
 */
const herencia = [
  {
    icon: 'sprout',
    label: 'Desarrollo y movimiento',
    items: [
      'Lesiones infantiles',
      'Psicomotricidad',
      'Estimulación temprana',
      'Valoración y orientación del desarrollo infantil',
      'Tortícolis congénita',
      'Parálisis braquial congénita',
      'Postura, volteo, gateo y primeros pasos',
    ],
  },
  {
    icon: 'wind',
    label: 'Respiratorio y cuidado diario',
    items: ['Fisioterapia respiratoria infantil', 'Masaje infantil', 'Higiene nasal'],
  },
  {
    icon: 'moon',
    label: 'Crianza y hábitos',
    items: [
      'Dificultades de sueño o insomnio del lactante',
      'Hábitos alimentarios infantiles',
      'Rabietas y dificultades de conducta',
      'Orientación en control de esfínteres',
      'Enuresis y encopresis',
      'Celos infantiles',
    ],
  },
  {
    icon: 'users',
    label: 'Talleres y actividades',
    items: [
      'Taller Moquitos',
      'Baby-Nesst: gateo y desarrollo psicomotor de 4 a 12 meses',
      'Estimulación sensorial de 0 a 6 meses',
      'Taller de lenguaje y signos del bebé',
      'Taller de masaje infantil',
    ],
  },
] as const;

const faqs = [
  {
    q: '¿Desde qué edad podéis atender a un bebé?',
    a: 'La web original de Centro Spai presenta atención a bebés desde las primeras semanas. Si la cita encaja con su edad y su situación lo confirma el centro al pedirla.',
  },
  {
    q: '¿Necesito que el pediatra me derive?',
    a: 'No suele ser necesario para pedir cita. Aun así, si tenéis informes o indicaciones del pediatra, llevarlos ayuda a entender mejor el caso.',
  },
  {
    q: '¿Qué debo llevar a la primera sesión?',
    a: 'Ropa cómoda para el bebé, un pañal y una muda de repuesto, y lo que suele calmarle (chupete, mantita). Si tenéis informes médicos, también son útiles.',
  },
  {
    q: '¿Puedo estar presente durante la sesión?',
    a: 'La propuesta de esta web es que la familia esté presente y pueda preguntar durante la sesión. El centro confirmará cómo lo organiza en cada caso.',
  },
  {
    q: '¿Cuántas sesiones hacen falta?',
    a: 'No es algo que se pueda anticipar desde una web ni prometer de antemano: depende de cada bebé y corresponde valorarlo al profesional que le atiende.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  tone="infantil"
  image="images/infantil/fisioterapia-para-bebes.jpg"
  imageAlt="Bebé sonriente tumbado de lado sobre una manta blanca"
  preloadImage="images/infantil/fisioterapia-para-bebes.jpg"
  breadcrumbs={breadcrumbs}
  jsonLd={[serviceSchema('Fisioterapia infantil', description)]}
>
  <PageHero
    tone="infantil"
    eyebrow="Ruta infantil · Bebés y niños"
    lead="Fisioterapia y osteopatía pensadas para los más pequeños, con tiempo para la familia y para sus preguntas."
    breadcrumbs={breadcrumbs}
    image={{
      src: 'infantil/fisioterapia-para-bebes.jpg',
      alt: 'Bebé sonriente tumbado de lado sobre una manta blanca',
      width: 851,
      height: 955,
      position: '60% 50%',
      enhance: true,
    }}
  >
    <Fragment slot="title">Fisioterapia infantil <em>en Burriana</em></Fragment>
    <Fragment slot="actions">
      <a class="btn btn--lg" href={citaHref('infantil')}>
        Solicitar cita infantil
        <Icon name="arrow-right" />
      </a>
      <a class="btn btn--secondary btn--lg" href="#servicios">Ver servicios</a>
    </Fragment>
  </PageHero>

  <RouteNav currentPath={path} tone="infantil" label="Ruta infantil" items={INFANTIL_NAV} />

  <!-- Explicación humana -->
  <section class="section" aria-labelledby="enfoque-title">
    <div class="container" style="margin-bottom: var(--space-6);">
      <div class="clinical-note" role="note" data-reveal>
        <Icon name="info" size={20} />
        <p>
          <strong>Aviso sanitario:</strong> Información divulgativa sobre fisioterapia pediátrica pendiente de validación clínica por el equipo del centro. No sustituye la valoración del pediatra ni de otro profesional sanitario.
        </p>
      </div>
    </div>
    <div class="container intro">
      <div class="intro__lead" data-reveal>
        <span class="eyebrow">Nuestro enfoque</span>
        <h2 id="enfoque-title">Tratamos al bebé, <em>acompañamos a la familia</em></h2>
      </div>
      <div class="intro__text" data-reveal>
        <p class="lead">
          La fisioterapia infantil ayuda a los bebés y niños en momentos concretos de su desarrollo: cuando algo les
          incomoda, cuando un proceso respiratorio se alarga o cuando la familia quiere entender mejor cómo
          acompañar su crecimiento.
        </p>
        <p>
          En Spai trabajamos con técnicas manuales suaves, observación y juego, siempre adaptados a la edad y a cómo
          está el bebé ese día. Y dedicamos tiempo a explicaros qué vemos, porque buena parte del cuidado ocurre en
          casa.
        </p>
      </div>
    </div>
  </section>

  <!-- Servicios por etapa -->
  <section class="section surface-kids" id="servicios" aria-labelledby="servicios-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Servicios por necesidad y etapa</span>
        <h2 id="servicios-title">Encuentra lo que <em>necesitáis</em></h2>
        <p class="lead">Agrupados por el momento que estáis viviendo, no por nombres técnicos.</p>
      </div>
      <div class="stages">
        {
          stages.map((stage, s) => (
            <div class="stage" data-reveal style={`--reveal-i:${s}`}>
              <h3 class="stage__label">
                <span class="stage__num" aria-hidden="true">{String(s + 1).padStart(2, '0')}</span>
                {stage.label}
              </h3>
              <ul class="stage__cards">
                {stage.items.map((item) => (
                  <li>
                    <NeedCard {...item} headingLevel="h4" />
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Detalle de servicios -->
  <section class="section" aria-label="Detalle de servicios">
    <div class="container details">
      <ServiceEditorial
        id="desarrollo"
        eyebrow="Desarrollo y movimiento"
        image={{
          src: 'infantil/fisioterapia-infantil.png',
          alt: 'Ilustración de un bebé gateando',
          width: 345,
          height: 253,
          fit: 'contain',
        }}
      >
        <h2>Cada etapa, <em>a su ritmo</em></h2>
        <p>
          Cada bebé tiene su tiempo. Cuando a la familia le surgen dudas sobre cómo se mueve, cómo se sostiene o cómo
          avanza hacia el gateo y la marcha, el centro acompaña ese proceso con observación, juego y movimiento.
        </p>
        <Chips label="Temas habituales" items={['Postura y control de cabeza', 'Volteo y gateo', 'Primeros pasos', 'Psicomotricidad']} />
      </ServiceEditorial>

      <ServiceEditorial
        id="respiratorio"
        eyebrow="Fisioterapia respiratoria"
        reverse
        surface="info"
        image={{
          src: 'talleres-app/taller-moquitos.jpg',
          alt: 'Niña sonándose la nariz con un pañuelo',
          width: 1920,
          height: 699,
          position: '26% 50%',
        }}
      >
        <h2>Para los días de <em>mocos y congestión</em></h2>
        <p>
          Los procesos respiratorios son frecuentes en la infancia y a veces se alargan. La fisioterapia respiratoria
          infantil ayuda a movilizar secreciones con técnicas adaptadas, y os enseñamos cómo hacer una buena higiene
          nasal en casa.
        </p>
        <p class="note">
          <Icon name="info" size={18} />
          Si hay dificultad para respirar, fiebre alta o decaimiento, acude antes a tu pediatra o a urgencias.
        </p>
      </ServiceEditorial>

      <ServiceEditorial id="orientacion" eyebrow="Masaje y orientación a familias" surface="warm">
        <div slot="media" class="quote-panel">
          <p class="quote-panel__text">“Los pequeños gestos de casa también forman parte del cuidado.”</p>
          <span class="quote-panel__sign">Principio de trabajo de Spai</span>
        </div>
        <h2>Rutinas, masaje <em>y crianza</em></h2>
        <p>
          Os acompañamos en las dudas del día a día: cómo sostener y cambiar de postura al bebé, rutinas de sueño y
          baño, o cómo aprovechar el masaje infantil como un momento de conexión y tranquilidad.
        </p>
        <ul class="check-list">
          <li>Masaje infantil guiado para hacerlo en casa.</li>
          <li>Pautas de postura y manejo en los primeros meses.</li>
          <li>Hábitos y rutinas adaptados a vuestra familia.</li>
        </ul>
      </ServiceEditorial>
    </div>
  </section>

  <!-- Catálogo heredado de la web original -->
  <section class="section surface-warm" id="herencia" aria-labelledby="herencia-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Catálogo heredado</span>
        <h2 id="herencia-title">Servicios y talleres que formaban parte <em>de Centro Spai</em></h2>
        <p class="lead">
          Ámbitos que aparecían en la web original del centro, agrupados para que se lean con claridad. Algunos son
          temas de acompañamiento a la familia y otros requieren valoración sanitaria: su vigencia y su alcance
          actual los confirmará el centro.
        </p>
      </div>
      <div class="heritage-grid">
        {
          herencia.map((group, i) => (
            <section class="heritage-group" data-reveal style={`--reveal-i:${i}`} aria-label={group.label}>
              <h3 class="heritage-group__title">
                <span class="heritage-group__icon">
                  <Icon name={group.icon} size={22} />
                </span>
                {group.label}
              </h3>
              <ul class="heritage-group__list">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <p class="heritage-note" data-reveal>
        <Icon name="info" size={20} />
        <span>
          Este listado documenta la oferta publicada históricamente, no un diagnóstico ni un compromiso de
          tratamiento. Para cualquier problema de salud del bebé, la referencia es siempre su pediatra.
        </span>
      </p>
    </div>
  </section>

  <!-- Primera visita -->
  <section class="section surface-kids" aria-labelledby="visita-title">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <span class="eyebrow">Primera visita</span>
          <h2 id="visita-title">Cómo imaginamos <em>la primera cita</em></h2>
          <p class="proposal-tag">Propuesta de experiencia, pendiente de validar con el centro</p>
        </div>
        <p class="lead">Una sesión tranquila, con tiempo para escuchar y para resolver vuestras dudas.</p>
      </div>
      <Timeline
        steps={[
          {
            icon: 'chat',
            title: 'Cuéntanos',
            text: 'Hablamos sobre el bebé, su día a día y lo que os preocupa. Si tenéis informes, los revisamos.',
          },
          {
            icon: 'clipboard',
            title: 'Valoración',
            text: 'Observamos cómo se mueve, cómo reacciona y cómo está, siempre con delicadeza y respetando sus pausas.',
          },
          {
            icon: 'path',
            title: 'Acompañamiento',
            text: 'Un espacio para preguntar sin prisa y salir de la consulta entendiendo lo que se ha hecho.',
          },
        ]}
      />
    </div>
  </section>

  <!-- Enfoque profesional -->
  <section class="section" aria-labelledby="equipo-title">
    <div class="container team">
      <div class="team__head" data-reveal>
        <span class="eyebrow">Enfoque profesional</span>
        <h2 id="equipo-title">Quién atiende <em>a vuestro bebé</em></h2>
        <p class="muted">
          Cada familia debe saber quién atiende a su bebé. En la versión publicada, aquí aparecerán los perfiles
          del equipo, con nombre, titulación, colegiación y enfoque, una vez los aporte y valide el centro.
        </p>
      </div>
      <ul class="team__grid">
        {
          [1, 2].map((n) => (
            <li class="profile" data-reveal style={`--reveal-i:${n}`}>
              <div class="profile__avatar" aria-hidden="true">
                <Icon name="person" size={36} />
              </div>
              <div class="profile__body">
                <span class="pending">Perfil pendiente de validar</span>
                <p class="profile__role">Fisioterapia y osteopatía infantil</p>
                <dl class="profile__fields">
                  <div>
                    <dt>Nombre</dt>
                    <dd>Lo aporta el centro</dd>
                  </div>
                  <div>
                    <dt>Titulación y colegiación</dt>
                    <dd>Lo aporta el centro</dd>
                  </div>
                  <div>
                    <dt>Enfoque</dt>
                    <dd>Lo aporta el centro</dd>
                  </div>
                </dl>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq items={faqs} tone="infantil" intro="Lo que más nos preguntan las familias antes de su primera cita." />

  <CtaBand
    tone="infantil"
    title="¿Hablamos de vuestro bebé?"
    text="Escríbenos contando qué os preocupa y el centro os dirá qué cita encaja mejor."
  />
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 56rem) {
    .intro {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-8);
    }
  }

  .intro__lead {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
  }

  .stages {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 64rem) {
    .stages {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .stage__label {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-4);
    border-bottom: 1.5px solid var(--spai-300);
    font-size: 1.5rem;
  }

  .stage__num {
    font-size: 0.9375rem;
    color: var(--spai-500);
  }

  .stage__cards {
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .stage__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .details {
    display: grid;
    gap: clamp(4rem, 3rem + 5vw, 7rem);
  }

  .note {
    display: flex;
    gap: var(--space-2);
    font-size: var(--fs-small);
    color: var(--text-muted);
    padding-left: var(--space-3);
    border-left: 2px solid var(--sky-200);
  }

  .note :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--sky-800);
  }

  .quote-panel {
    display: grid;
    align-content: center;
    gap: var(--space-5);
    height: 100%;
    padding: clamp(2rem, 1rem + 4vw, 4rem);
  }

  .quote-panel__text {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    font-style: italic;
    font-weight: 460;
    line-height: 1.2;
    color: var(--spai-700);
  }

  .quote-panel__sign {
    font-size: var(--fs-small);
    font-weight: 650;
    color: var(--ink-600);
  }

  .heritage-grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .heritage-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .heritage-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .heritage-group {
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--white);
    border: 1px solid var(--line);
  }

  .heritage-group__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.25rem;
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--line-soft);
  }

  .heritage-group__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 12px;
    background: var(--blush-100);
    color: var(--spai-700);
  }

  .heritage-group__list {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .heritage-group__list li::marker {
    color: var(--spai-300);
  }

  .heritage-note {
    display: flex;
    gap: var(--space-3);
    max-width: 52rem;
    margin-top: var(--space-6);
    font-size: var(--fs-small);
    color: var(--ink-900);
  }

  .heritage-note :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--spai-500);
  }

  .team {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 56rem) {
    .team {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-8);
      align-items: center;
    }
  }

  .team__head {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .team__grid {
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .team__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .profile {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-card);
    border: 1.5px dashed var(--spai-300);
    background: var(--white);
  }

  .profile__avatar {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--lilac-100);
    color: var(--spai-500);
  }

  .profile__body {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .profile__role {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--spai-700);
    line-height: 1.3;
  }

  .profile__fields {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    width: 100%;
  }

  .profile__fields div {
    display: grid;
    gap: 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line-soft);
  }

  .profile__fields dt {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink-600);
  }

  .profile__fields dd {
    margin: 0;
    color: var(--ink-400);
    font-style: italic;
  }
</style>
