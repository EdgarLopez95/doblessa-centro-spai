---
import Icon from './Icon.astro';
import Picture from './Picture.astro';
import { CONTACT, ROUTES, SITE, citaHref, withBase } from '../lib/site';

const year = 2026;
const columns = [
  {
    title: 'Infantil',
    links: [
      { label: 'Fisioterapia infantil', href: ROUTES.infantil },
      { label: 'Cólicos del lactante', href: ROUTES.colicos },
      { label: 'Osteopatía para bebés', href: ROUTES.osteopatia },
      { label: 'Talleres para familias', href: ROUTES.talleres },
    ],
  },
  {
    title: 'Adultos y bienestar',
    links: [
      { label: 'Fisioterapia para adultos', href: ROUTES.adultos },
      { label: 'Embarazo y posparto', href: ROUTES.embarazo },
    ],
  },
  {
    title: 'Spai',
    links: [
      { label: 'El centro', href: ROUTES.centro },
      { label: 'Contacto y cita', href: ROUTES.contacto },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href={withBase(ROUTES.home)} class="site-footer__logo" aria-label="Centro Spai, ir al inicio">
          <Picture src="marca/logo-centro-spai.png" alt="" width={346} height={103} loading="lazy" decoding="async" />
        </a>
        <p class="site-footer__claim">Bienestar, salud <em>y relajación.</em></p>
        <p class="site-footer__text">
          Fisioterapia y osteopatía para bebés, niños y familias en Burriana. Y un espacio también para ti.
        </p>
        <div class="btn-row">
          <a class="btn btn--on-brand" href={citaHref('infantil')}>Cita infantil</a>
          <a class="btn site-footer__btn-outline" href={citaHref('adultos')}>Cita adultos</a>
        </div>
      </div>

      <div class="site-footer__navigation" aria-label="Navegación del pie de página">
        {
          columns.map((col) => (
            <nav class="site-footer__col" aria-label={col.title}>
              <h2 class="site-footer__title">{col.title}</h2>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a href={withBase(l.href)}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>

      <section class="site-footer__contact-panel" aria-labelledby="footer-contact-title">
        <h2 id="footer-contact-title" class="site-footer__title">Dónde estamos</h2>
        <address class="site-footer__address">
          <div class="site-footer__contact-item">
            <span class="site-footer__contact-icon"><Icon name="pin" size={18} /></span>
            <span class="site-footer__contact-copy">
              {SITE.address.street}<br />
              {SITE.address.postalCode} {SITE.address.locality} ({SITE.address.region})
            </span>
          </div>
          <div class="site-footer__contact-item">
            <span class="site-footer__contact-icon"><Icon name="baby" size={18} /></span>
            <span class="site-footer__contact-copy">
              {CONTACT.infantil.label}<br />
              <a class="site-footer__contact" href={`tel:${CONTACT.infantil.tel}`}>{CONTACT.infantil.display}</a>
            </span>
          </div>
          <div class="site-footer__contact-item">
            <span class="site-footer__contact-icon"><Icon name="person" size={18} /></span>
            <span class="site-footer__contact-copy">
              {CONTACT.adultos.label}<br />
              <a class="site-footer__contact" href={`tel:${CONTACT.adultos.tel}`}>{CONTACT.adultos.display}</a>
            </span>
          </div>
          <div class="site-footer__contact-item">
            <span class="site-footer__contact-icon"><Icon name="mail" size={18} /></span>
            <span class="site-footer__contact-copy"><a class="site-footer__contact" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></span>
          </div>
          <div class="site-footer__contact-item">
            <span class="site-footer__contact-icon"><Icon name="chat" size={18} /></span>
            <span class="site-footer__contact-copy">{CONTACT.whatsapp.label}: {CONTACT.whatsapp.display.toLowerCase()}</span>
          </div>
        </address>
        <p class="site-footer__domain-note">Web actual del centro: {CONTACT.currentDomain}</p>
      </section>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} Centro Spai</p>
      <ul>
        <li><a href={withBase(ROUTES.privacidad)}>Política de privacidad</a></li>
        <li><a href={withBase(ROUTES.avisoLegal)}>Aviso legal</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--spai-700);
    color: #efe9f6;
    padding-block: clamp(3.25rem, 5vw, 4.75rem) var(--space-4);
  }

  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--blush-300) 0 33%, var(--sky-200) 33% 66%, var(--sage-200) 66%);
  }

  .site-footer__top {
    display: grid;
    align-items: start;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .site-footer__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }

    .site-footer__navigation {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .site-footer__top {
      grid-template-columns: minmax(14rem, 0.95fr) minmax(27rem, 1.7fr) minmax(19rem, 1.05fr);
      gap: clamp(2rem, 3.5vw, 4.5rem);
    }

    .site-footer__brand,
    .site-footer__navigation {
      grid-column: auto;
    }
  }

  .site-footer__logo {
    display: inline-block;
    margin-bottom: var(--space-3);
  }

  .site-footer__logo :global(img) {
    height: 52px;
    width: auto;
  }

  .site-footer__claim {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--white);
    margin-bottom: var(--space-3);
  }

  .site-footer__claim em {
    color: var(--blush-300);
    font-weight: 460;
  }

  .site-footer__text {
    max-width: 30rem;
    margin-bottom: var(--space-4);
    color: #ddd3ea;
  }

  .site-footer__navigation {
    display: grid;
    align-content: start;
    gap: var(--space-5) var(--space-4);
  }

  @media (min-width: 40rem) {
    .site-footer__navigation {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    }

    .site-footer__navigation .site-footer__col:nth-child(3) {
      grid-column: 2;
    }
  }

  .site-footer__btn-outline {
    --btn-bg: transparent;
    --btn-fg: var(--white);
    --btn-border: rgb(255 255 255 / 0.5);
  }

  .site-footer__btn-outline:hover {
    --btn-bg: rgb(255 255 255 / 0.1);
    --btn-border: var(--white);
    box-shadow: none;
  }

  .site-footer__title {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    color: var(--blush-300);
    margin-bottom: var(--space-2);
  }

  .site-footer__col ul {
    list-style: none;
  }

  .site-footer a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    color: var(--white);
    text-decoration: none;
  }

  .site-footer a:not(.btn):hover {
    color: var(--blush-300);
    text-decoration: underline;
  }

  .site-footer :focus-visible {
    outline-color: var(--white);
  }

  .site-footer__contact-panel {
    padding: var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: var(--radius-card);
    background: rgb(255 255 255 / 0.06);
  }

  .site-footer__contact-panel .site-footer__title {
    margin-bottom: var(--space-3);
  }

  .site-footer__address {
    font-style: normal;
    display: grid;
    color: #efe9f6;
  }

  .site-footer__contact-item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-2);
    align-items: start;
    padding-block: 0.7rem;
    line-height: 1.5;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .site-footer__contact-item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .site-footer__contact-item:last-child {
    padding-bottom: 0;
  }

  .site-footer__contact-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: var(--blush-300);
  }

  .site-footer__contact-copy {
    min-width: 0;
  }

  .site-footer__contact {
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .site-footer__domain-note {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #ddd3ea;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(255 255 255 / 0.18);
    font-size: var(--fs-small);
    color: #ddd3ea;
  }

  .site-footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    list-style: none;
  }
</style>
