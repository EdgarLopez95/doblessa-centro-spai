---
import Icon from './Icon.astro';
import Picture from './Picture.astro';
import { NAV, ROUTES, citaHref, isActive, withBase, type Tone } from '../lib/site';

interface Props {
  currentPath: string;
  tone: Tone;
}

const { currentPath, tone } = Astro.props;
const ctaLabel = tone === 'adultos' ? 'Pedir cita adultos' : tone === 'infantil' ? 'Pedir cita infantil' : 'Pedir cita';
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={withBase(ROUTES.home)} aria-label="Centro Spai, ir al inicio">
      <span class="brand__plate">
        <span class="brand__crop">
          <Picture src="marca/logo-centro-spai.png" alt="" width="346" height="103" loading="eager" decoding="sync" />
        </span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Principal">
      <ul class="nav-desktop__list">
        {
          NAV.map((item) => {
            const active = isActive(currentPath, item.match);
            if (item.children && item.children.length > 0) {
              return (
                <li class="nav-item nav-item--dropdown" data-dropdown>
                  <button
                    type="button"
                    class:list={['nav-link', 'nav-dropdown__btn', { 'is-active': active }]}
                    aria-expanded="false"
                    aria-haspopup="true"
                    data-dropdown-toggle
                  >
                    <span>{item.label}</span>
                    <Icon name="chevron-down" size={15} class="nav-chevron" />
                  </button>
                  <div class="nav-dropdown" data-dropdown-panel hidden>
                    <ul class="nav-dropdown__list">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={withBase(child.href)}
                            class:list={['nav-dropdown__link', { 'is-active': isActive(currentPath, [child.href]) }]}
                            aria-current={isActive(currentPath, [child.href]) ? 'page' : undefined}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              );
            }
            return (
              <li class="nav-item">
                <a
                  href={withBase(item.href)}
                  class:list={['nav-link', { 'is-active': active }]}
                  aria-current={isActive(currentPath, [item.href]) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class:list={['btn header-cta', { 'btn--well': tone === 'adultos' }]} href={citaHref(tone)}>
        <Icon name="calendar" size={18} />
        <span>{ctaLabel}</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-toggle
      >
        <span class="menu-toggle__open"><Icon name="menu" /></span>
        <span class="menu-toggle__close"><Icon name="close" /></span>
        <span class="visually-hidden" data-menu-label>Abrir menú</span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="menu-movil" data-menu hidden>
    <nav class="container mobile-menu__inner" aria-label="Principal móvil">
      <ul class="mobile-menu__list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                class:list={['mobile-menu__link', { 'is-active': isActive(currentPath, item.match) }]}
                aria-current={isActive(currentPath, [item.href]) ? 'page' : undefined}
              >
                {item.label}
                <Icon name="chevron-right" size={20} />
              </a>
              {item.children && (
                <ul class="mobile-menu__sub">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={withBase(child.href)}
                        aria-current={isActive(currentPath, [child.href]) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mobile-menu__cta">
        <a class="btn btn--lg btn--block" href={citaHref('infantil')}>Pedir cita infantil</a>
        <a class="btn btn--secondary btn--lg btn--block" href={citaHref('adultos')}>Pedir cita para adultos</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(250 250 252 / 0.92);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  .site-header.is-scrolled {
    background: var(--cloud-50);
    border-bottom-color: var(--line);
    box-shadow: 0 8px 24px -22px rgb(91 67 123 / 0.5);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-h);
  }

  /* Placa de marca: eco del rótulo violeta de la fachada */
  .brand {
    align-self: flex-start;
    display: block;
    flex: none;
    border-radius: 0 0 14px 14px;
  }

  .brand__plate {
    display: flex;
    align-items: center;
    height: calc(var(--header-h) + 10px);
    padding: 10px 18px 0;
    background: var(--spai-700);
    border-radius: 0 0 14px 14px;
    box-shadow: 0 12px 24px -16px rgb(71 52 95 / 0.7);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  /* Con scroll la placa se ajusta a la barra para no tapar contenido */
  .site-header.is-scrolled .brand__plate {
    height: var(--header-h);
    padding-top: 0;
    border-radius: 0 0 12px 12px;
  }

  .site-header.is-scrolled .brand__crop {
    --logo-h: 40px;
  }

  .brand:hover .brand__plate {
    background: var(--spai-800);
  }

  /* Recorte del lema (ilegible a este tamaño); el logo completo va en el footer */
  .brand__crop {
    --logo-h: 46px;
    display: block;
    width: calc(var(--logo-h) * 188 / 103);
    height: var(--logo-h);
    overflow: hidden;
  }

  .brand :global(img) {
    width: auto;
    max-width: none;
    height: var(--logo-h);
  }

  .brand:focus-visible {
    outline-offset: 2px;
  }

  .nav-desktop {
    margin-left: auto;
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.8rem;
    border-radius: 10px;
    color: var(--ink-900);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .nav-link:hover {
    background: var(--lilac-100);
    color: var(--spai-700);
  }

  .nav-link.is-active {
    color: var(--spai-700);
  }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 6px;
    height: 2px;
    border-radius: 2px;
    background: var(--blush-300);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header-cta {
    min-height: 46px;
    padding-inline: 1.1rem;
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--white);
    color: var(--spai-700);
  }

  .menu-toggle__close {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__close {
    display: block;
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    overflow-y: auto;
    background: var(--cloud-50);
    border-top: 1px solid var(--line);
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .mobile-menu.is-open {
    opacity: 1;
    transform: none;
  }

  .mobile-menu__inner {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-5) var(--space-7);
  }

  .mobile-menu__list {
    list-style: none;
  }

  .mobile-menu__list > li {
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 540;
    color: var(--spai-700);
    text-decoration: none;
  }

  .mobile-menu__link :global(svg) {
    color: var(--spai-500);
  }

  .mobile-menu__link.is-active {
    color: var(--spai-500);
  }

  .mobile-menu__sub {
    list-style: none;
    display: grid;
    padding: 0 0 var(--space-4) var(--space-4);
    margin-top: calc(var(--space-2) * -1);
    border-left: 2px solid var(--blush-300);
  }

  .mobile-menu__sub a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-600);
    font-weight: 600;
    text-decoration: none;
  }

  .mobile-menu__sub a[aria-current='page'] {
    color: var(--spai-700);
  }

  .mobile-menu__cta {
    display: grid;
    gap: var(--space-3);
  }

  @media (max-width: 63.99rem) {
    .nav-desktop {
      display: none;
    }

    .site-header__actions {
      margin-left: auto;
    }

    .menu-toggle {
      display: grid;
    }

    .brand__crop,
    .site-header.is-scrolled .brand__crop {
      --logo-h: 36px;
    }

    .brand__plate {
      padding: 8px 14px 0;
    }
  }

  @media (max-width: 35.99rem) {
    .header-cta {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .mobile-menu {
      display: none !important;
    }
  }

  @media (min-width: 64rem) and (max-width: 74.99rem) {
    .nav-link {
      padding: 0 0.6rem;
    }

    .nav-link.is-active::after {
      left: 0.6rem;
      right: 0.6rem;
    }

    .header-cta :global(svg) {
      display: none;
    }
  }

  /* Desplegables accesibles en escritorio */
  .nav-item {
    position: relative;
  }

  .nav-dropdown__btn {
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    gap: 0.35rem;
  }

  .nav-chevron {
    color: var(--spai-500);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .nav-dropdown__btn[aria-expanded='true'] .nav-chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 15rem;
    padding: var(--space-2);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lift);
    z-index: 60;
  }

  .nav-dropdown[hidden] {
    display: none;
  }

  .nav-dropdown__list {
    list-style: none;
    display: grid;
    gap: 2px;
    padding: 0;
    margin: 0;
  }

  .nav-dropdown__link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-900);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .nav-dropdown__link:hover {
    background: var(--lilac-100);
    color: var(--spai-700);
  }

  .nav-dropdown__link.is-active {
    background: var(--lilac-50);
    color: var(--spai-700);
    font-weight: 700;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (toggle && menu && label) {
    const focusables = () =>
      [toggle, ...menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
      document.documentElement.style.overflow = open ? 'hidden' : '';
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
      } else {
        menu.classList.remove('is-open');
        menu.hidden = true;
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
      }
      if (event.key === 'Tab') {
        const items = focusables();
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
      dropdowns.forEach((item) => {
        const btn = item.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
        const panel = item.querySelector<HTMLElement>('[data-dropdown-panel]');
        btn?.setAttribute('aria-expanded', 'false');
        if (panel) panel.hidden = true;
      });
    });
  }

  // Desplegables accesibles en escritorio (Infantil, Adultos)
  dropdowns.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    const panel = item.querySelector<HTMLElement>('[data-dropdown-panel]');
    if (!btn || !panel) return;

    let timer: number | undefined;
    let hoverOpenedAt = 0;

    const setDropdown = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (open) {
        dropdowns.forEach((other) => {
          if (other !== item) {
            const ob = other.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
            const op = other.querySelector<HTMLElement>('[data-dropdown-panel]');
            ob?.setAttribute('aria-expanded', 'false');
            if (op) op.hidden = true;
          }
        });
      }
    };

    btn.addEventListener('click', () => {
      const now = Date.now();
      if (now - hoverOpenedAt < 400 && btn.getAttribute('aria-expanded') === 'true') {
        return;
      }
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      setDropdown(!isOpen);
    });

    item.addEventListener('mouseenter', () => {
      if (window.matchMedia('(min-width: 64rem)').matches) {
        clearTimeout(timer);
        hoverOpenedAt = Date.now();
        setDropdown(true);
      }
    });

    item.addEventListener('mouseleave', () => {
      if (window.matchMedia('(min-width: 64rem)').matches) {
        timer = window.setTimeout(() => {
          setDropdown(false);
          hoverOpenedAt = 0;
        }, 150);
      }
    });

    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setDropdown(false);
        btn.focus();
      } else if (e.key === 'ArrowDown' && document.activeElement === btn) {
        e.preventDefault();
        setDropdown(true);
        const firstLink = panel.querySelector<HTMLAnchorElement>('a');
        firstLink?.focus();
      }
    });

    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node)) {
        setDropdown(false);
      }
    });
  });

  document.addEventListener('click', (e) => {
    dropdowns.forEach((item) => {
      if (!item.contains(e.target as Node)) {
        const btn = item.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
        const panel = item.querySelector<HTMLElement>('[data-dropdown-panel]');
        btn?.setAttribute('aria-expanded', 'false');
        if (panel) panel.hidden = true;
      }
    });
  });
</script>
