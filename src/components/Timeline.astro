---
import Icon, { type IconName } from './Icon.astro';
import type { Tone } from '../lib/site';

export interface Step {
  title: string;
  text: string;
  icon: IconName;
}

interface Props {
  steps?: Step[];
  tone?: Tone;
}

const defaultSteps: Step[] = [
  {
    icon: 'chat',
    title: 'Cuéntanos',
    text: 'Nos contáis qué os preocupa o qué necesitáis, con la calma de quien escucha antes de proponer nada.',
  },
  {
    icon: 'clipboard',
    title: 'Valoración',
    text: 'Un primer momento de observación, con calma y sin tecnicismos.',
  },
  {
    icon: 'path',
    title: 'Acompañamiento',
    text: 'Un espacio para preguntar sin prisa y salir entendiendo lo que se ha hecho en la sesión.',
  },
];

const { steps = defaultSteps, tone = 'infantil' } = Astro.props;
---

<ol class:list={['timeline', `timeline--${tone}`]}>
  {
    steps.map((s, i) => (
      <li class="timeline__step" data-reveal style={`--reveal-i:${i}`}>
        <div class="timeline__marker">
          <span class="timeline__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="timeline__icon">
            <Icon name={s.icon} size={24} />
          </span>
        </div>
        <div class="timeline__body">
          <h3 class="timeline__title">
            <span class="visually-hidden">Paso {i + 1}: </span>
            {s.title}
          </h3>
          <p>{s.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    --tl-soft: var(--lilac-100);
    --tl-ink: var(--spai-700);
    --tl-line: var(--spai-300);
    list-style: none;
    display: grid;
    gap: var(--space-5);
    counter-reset: step;
  }

  .timeline--adultos {
    --tl-soft: var(--sage-100);
    --tl-ink: var(--sage-800);
    --tl-line: var(--sage-200);
  }

  .timeline__step {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
  }

  .timeline__marker {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
  }

  .timeline__num {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-style: italic;
    font-weight: 460;
    line-height: 1;
    color: var(--tl-ink);
    opacity: 0.85;
  }

  .timeline__icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--white);
    border: 1.5px solid var(--tl-line);
    color: var(--tl-ink);
  }

  .timeline__body {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-5);
  }

  .timeline__title {
    font-size: 1.5rem;
  }

  .timeline__body p {
    color: var(--text-muted);
    max-width: 22rem;
  }

  /* Línea conectora vertical (móvil) */
  .timeline__step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.75rem;
    top: calc(2.25rem + var(--space-2) + 3.5rem);
    bottom: calc(var(--space-5) * -1);
    width: 1.5px;
    background: repeating-linear-gradient(to bottom, var(--tl-line) 0 6px, transparent 6px 12px);
  }

  @media (min-width: 48rem) {
    .timeline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .timeline__step {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .timeline__marker {
      justify-items: start;
    }

    .timeline__body {
      padding-top: 0;
    }

    .timeline__step:not(:last-child)::before {
      left: 4.5rem;
      right: calc(var(--space-6) * -1 + 0.5rem);
      top: calc(2.25rem + var(--space-2) + 1.75rem);
      bottom: auto;
      width: auto;
      height: 1.5px;
      background: repeating-linear-gradient(to right, var(--tl-line) 0 6px, transparent 6px 12px);
    }
  }
</style>
