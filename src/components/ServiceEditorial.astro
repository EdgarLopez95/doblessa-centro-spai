---
import Picture from './Picture.astro';
import { type Tone } from '../lib/site';

interface Props {
  id?: string;
  eyebrow?: string;
  tone?: Tone;
  reverse?: boolean;
  image?: {
    src: string;
    alt: string;
    width: number;
    height: number;
    fit?: 'cover' | 'contain';
    position?: string;
  };
  /** Superficie del bloque multimedia si no hay imagen. */
  surface?: 'kids' | 'warm' | 'well' | 'info';
}

const { id, eyebrow, tone = 'infantil', reverse = false, image, surface = 'kids' } = Astro.props;
---

<div id={id} class:list={['editorial', { 'editorial--reverse': reverse }]} data-reveal>
  <div class:list={['editorial__media', `editorial__media--${surface}`, { 'is-contain': image?.fit === 'contain' }]}>
    {
      image ? (
        <Picture
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
          class:list={{ illus: image.fit === 'contain' }}
          style={image.position ? `object-position:${image.position}` : undefined}
        />
      ) : (
        <slot name="media" />
      )
    }
  </div>
  <div class="editorial__body">
    {eyebrow && <span class:list={['eyebrow', { 'eyebrow--well': tone === 'adultos' }]}>{eyebrow}</span>}
    <slot />
  </div>
</div>

<style>
  .editorial {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .editorial {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-8);
    }

    .editorial--reverse .editorial__media {
      order: 2;
    }
  }

  .editorial__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-panel);
    aspect-ratio: 4 / 3.4;
  }

  .editorial__media--kids {
    background: var(--lilac-100);
  }

  .editorial__media--warm {
    background: var(--blush-100);
  }

  .editorial__media--well {
    background: var(--sage-100);
  }

  .editorial__media--info {
    background: var(--sky-100);
  }

  .editorial__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial__media.is-contain {
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
  }

  .editorial__media.is-contain img {
    --illus-size: 20rem;
    width: var(--illus-size);
    height: auto;
  }

  .editorial__body {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .editorial__body :global(h2) {
    margin-bottom: var(--space-1);
  }

  .editorial__body :global(.btn-row),
  .editorial__body :global(.check-list) {
    margin-top: var(--space-2);
  }
</style>
